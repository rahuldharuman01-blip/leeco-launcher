<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <solid android:color="#F9FCFE"/>
            <corners android:radius="24dp"/>
            <stroke android:width="3dp" android:color="#4D718F"/>
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#F2F7FA"/>
            <corners android:radius="24dp"/>
            <stroke android:width="3dp" android:color="#4D718F"/>
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#DDE5EB"/>
            <corners android:radius="24dp"/>
        </shape>
    </item>
</selector>
